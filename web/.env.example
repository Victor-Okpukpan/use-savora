# Privy app id — create one at https://dashboard.privy.io (free).
# The app renders without it, but the connect flow needs it.
NEXT_PUBLIC_PRIVY_APP_ID=

# HTTP reads — a dedicated devnet RPC (Alchemy / Helius / Triton free tier).
# The public https://api.devnet.solana.com works but rate-limits under load.
NEXT_PUBLIC_SOLANA_RPC_URL=

# WebSocket subscriptions — used by Privy to confirm sent transactions.
# Note: Alchemy's free tier does NOT support Solana subscriptions
# (accountSubscribe / signatureSubscribe return "method not found"). The public
# devnet WS does, and subscription load is light, so it's a fine default here.
NEXT_PUBLIC_SOLANA_RPC_SUBSCRIPTIONS_URL=wss://api.devnet.solana.com

# Optional — the canonical origin for metadata / sitemap / OG URLs. Leave blank
# to use the Vercel production URL (or the hardcoded fallback in src/lib/site.ts).
# Set it once a custom domain is live.
NEXT_PUBLIC_SITE_URL=
