# Privy app id — create one at https://dashboard.privy.io (free).
# The app renders without it, but the connect flow needs it.
NEXT_PUBLIC_PRIVY_APP_ID=

# HTTP reads — a dedicated devnet RPC (Alchemy / Helius / Triton free tier).
# The public https://api.devnet.solana.com works but rate-limits under load.
NEXT_PUBLIC_SOLANA_RPC_URL=

# getProgramAccounts scans — used to list the circles a wallet belongs to.
# Alchemy's free tier rejects this method outright, so when the main RPC is an
# Alchemy URL this automatically falls back to the public devnet RPC. Set it
# explicitly to point the scan somewhere else (e.g. Helius / Triton free tier).
NEXT_PUBLIC_SOLANA_RPC_SCAN_URL=

# WebSocket subscriptions — handed to PrivyProvider; Privy uses it to confirm
# sent transactions. This MUST be a node that serves signatureSubscribe.
# Alchemy's free tier does NOT (accountSubscribe / signatureSubscribe return
# "method not found") — pointing this at an Alchemy URL makes every Privy
# confirmation fail and surface as a red "Something went wrong" modal even
# though the transaction landed. Keep it on the public devnet WS. Set the SAME
# value in the Vercel project env, not just here.
NEXT_PUBLIC_SOLANA_RPC_SUBSCRIPTIONS_URL=wss://api.devnet.solana.com

# Optional — the canonical origin for metadata / sitemap / OG URLs. Leave blank
# to use the Vercel production URL (or the hardcoded fallback in src/lib/site.ts).
# Set it once a custom domain is live.
NEXT_PUBLIC_SITE_URL=
